# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gaplens

# ─── OpenAI (Required) ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── Clerk (Authentication) ───────────────────────────────────────────────────
# Required in production. Leave blank to disable auth in development.
CLERK_ISSUER_URL=https://your-clerk-domain.clerk.accounts.dev
CLERK_SECRET_KEY=sk_...

# ─── Lemon Squeezy (Payments) ─────────────────────────────────────────────────
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ─── Sentry (Error Tracking) ──────────────────────────────────────────────────
SENTRY_DSN=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated. For production: https://gaplens.io,https://www.gaplens.io
CORS_ORIGINS=http://localhost:3000

# ─── App Settings ─────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=development
RATE_LIMIT=10/minute

# ─── Pipeline Tuning ──────────────────────────────────────────────────────────
# Maximum seconds before a search pipeline is force-killed (default: 600)
PIPELINE_TIMEOUT_SECONDS=600
# Maximum raw posts fed into the AI clustering step to control cost (default: 300)
MAX_POSTS_PER_PIPELINE=300

# ─── Optional: Data Source API Keys ──────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=GapLens/1.0
G2_API_KEY=
YOUTUBE_API_KEY=
