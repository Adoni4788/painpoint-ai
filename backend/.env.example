DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/painpoint
OPENAI_API_KEY=sk-your-key-here
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PainPointAI/1.0
G2_API_KEY=
YOUTUBE_API_KEY=
# Comma-separated. For production, include: https://painpoint-ai-frontend.onrender.com
CORS_ORIGINS=http://localhost:3000

# Optional: Sentry DSN for error monitoring (https://sentry.io)
SENTRY_DSN=

# Rate limit for expensive endpoints (e.g. 10/minute)
RATE_LIMIT=10/minute

# --- Authentication (C1) ---
# Leave blank to disable auth in development.
# In production, set a strong random secret (e.g. openssl rand -hex 32).
# The frontend must send this value in the X-Api-Key request header.
API_KEY_SECRET=

# --- Pipeline tuning ---
# Maximum seconds before a search pipeline is force-killed (default: 600)
PIPELINE_TIMEOUT_SECONDS=600
# Maximum raw posts fed into the AI clustering step to control cost (default: 300)
MAX_POSTS_PER_PIPELINE=300
