# ─── API ──────────────────────────────────────────────────────────────────────
# Leave unset for local dev (defaults to http://localhost:8000)
NEXT_PUBLIC_API_URL=https://painpoint-ai-backend.onrender.com

# ─── Clerk (Authentication) ── Required ───────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# ─── PostHog (Analytics) ── Required in production ───────────────────────────
# Sign up at https://posthog.com — free tier includes 1M events/month
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Sentry (Error Tracking) ── Required in production ───────────────────────
# Sign up at https://sentry.io — free tier available
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_...

# ─── Loops (Email Marketing) ── Required for landing page signup ───────────────
# Sign up at https://loops.so — free up to 2,500 contacts
LOOPS_API_KEY=loops_...
