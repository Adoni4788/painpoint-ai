# Backend API URL - used for rewrites in production
# Leave unset for local dev (defaults to http://localhost:8000)
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# PostHog analytics (Experiment 2 - Validate flow engagement)
# Sign up at https://posthog.com - free tier includes 1M events/month
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry error monitoring (optional)
# Sign up at https://sentry.io - free tier available
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
